{
    "workbench.colorCustomizations": {
        "activityBar.background": "#551913",
        "titleBar.activeBackground": "#77231B",
        "titleBar.activeForeground": "#FEFCFC",
        "titleBar.inactiveBackground": "#551913",
        "titleBar.inactiveForeground": "#FEFCFC",
        "statusBar.background": "#551913",
        "statusBar.foreground": "#FEFCFC",
        "statusBar.debuggingBackground": "#551913",
        "statusBar.debuggingForeground": "#FEFCFC",
        "statusBar.noFolderBackground": "#551913",
        "statusBar.noFolderForeground": "#FEFCFC"
    },
    "prettier.resolveGlobalModules": false,
    "prettier.prettierPath": "./node_modules/prettier",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "prettier.logLevel": "debug",
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}